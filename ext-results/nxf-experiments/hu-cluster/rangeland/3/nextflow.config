params {
    input     = '/input/input/landsat'
    dem       = '/input/input/dem'
    wvdb      = '/input/input/wvdb'
    data_cube = '/input/input/datacube-definition.prj'
    aoi       = '/input/input/aoi.gpkg'
    endmember = '/input/input/hostert-2003.txt'
    resolution     = 30
//    start_date     = "1984-01-01"
//    end_date       = "2006-12-31"
//    start_date = '1997-01-01'
    start_date = '1984-01-01'
    end_date   = '1999-01-01'
    sensors_level2 = 'LND04 LND05'
    group_size = 100
    // Workflow configuration
    save_ard            = false
    save_tsa            = false
    publish_dir_enabled = true
    // Higher Level processing configuration
    indexes    = "NDVI BLUE GREEN RED NIR SWIR1 SWIR2"
    return_tss = false
    // Visualization
    mosaic_visualization  = true
    pyramid_visualization = true
    outdir = '/input/data/outdata/'
    forceVer = '3.6.5'
    publish = false
    skipCheckResults = true
}

plugins {
    id 'nf-datatrail'
}

datatrail {
    input = '/input/data/outdata/input.csv'
    output = '/input/data/outdata/output.csv'
    summary = '/input/data/output/summary.csv'
}
